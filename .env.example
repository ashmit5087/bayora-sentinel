# Copy to .env, or just run:  python scripts/gen_env.py
# Never commit .env. Generate each token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_WRITE_TOKEN=
AUDIT_READ_TOKEN=
GATEWAY_TOKEN_RED=
GATEWAY_TOKEN_BLUE=
GATEWAY_TOKEN_AUDITOR=
GATEWAY_SHARED_API_KEY=   # used only by compose.insecure.yaml

# mock = pipeline mechanics only (not real model behaviour) | llama = local llama.cpp
MODEL_BACKEND=mock
# isolated | shared | off
CACHE_MODE=isolated
